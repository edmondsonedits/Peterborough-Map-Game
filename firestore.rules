rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Commercial analytics target: never expose raw analytics records publicly.
    // Writes should move through an authenticated/validated backend before these
    // rules are deployed to production. Server SDKs use IAM rather than rules.
    match /siteAnalytics/{documentId} {
      allow read, delete: if admin();
      allow create, update: if false;
    }

    // Transitional public-demo Geo Guesser leaderboard. Public score creation is
    // tightly schema/range limited; paid department deployments disable this by
    // default in the client. Move writes behind App Check/auth/backend before a
    // larger public launch if abuse becomes a concern.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'playerName',
          'station',
          'callType',
          'responseTimeSeconds',
          'score',
          'createdAt'
        ]) &&
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 1 &&
        request.resource.data.playerName.size() <= 30 &&
        request.resource.data.station is string &&
        request.resource.data.station.size() >= 1 &&
        request.resource.data.station.size() <= 60 &&
        request.resource.data.callType is string &&
        request.resource.data.callType.size() >= 1 &&
        request.resource.data.callType.size() <= 80 &&
        request.resource.data.responseTimeSeconds is number &&
        request.resource.data.responseTimeSeconds >= 0 &&
        request.resource.data.responseTimeSeconds <= 7200 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 7200 &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
