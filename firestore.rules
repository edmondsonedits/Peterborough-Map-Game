rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validPublicScore(data) {
      return
        data.keys().hasOnly([
          'playerName',
          'station',
          'callType',
          'responseTimeSeconds',
          'score',
          'createdAt'
        ]) &&
        data.playerName is string &&
        data.playerName.size() >= 1 &&
        data.playerName.size() <= 30 &&
        data.station is string &&
        data.station.size() >= 1 &&
        data.station.size() <= 60 &&
        data.callType is string &&
        data.callType.size() >= 1 &&
        data.callType.size() <= 80 &&
        data.responseTimeSeconds is number &&
        data.responseTimeSeconds >= 0 &&
        data.responseTimeSeconds <= 7200 &&
        data.score is number &&
        data.score >= 0 &&
        data.score <= 7200 &&
        data.createdAt is timestamp;
    }

    // Commercial analytics target: never expose raw analytics records publicly.
    // Writes should move through an authenticated/validated backend before these
    // rules are deployed to production. Server SDKs use IAM rather than rules.
    match /siteAnalytics/{documentId} {
      allow read, delete: if admin();
      allow create, update: if false;
    }

    // Transitional public-demo Geo Guesser leaderboard. Only documents that
    // match the public score schema can be read without admin authorization.
    // This also prevents legacy analytics fallback records in this collection
    // from becoming publicly readable after these rules are deployed.
    match /scores/{scoreId} {
      allow read: if admin() || validPublicScore(resource.data);
      allow create: if validPublicScore(request.resource.data);
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
